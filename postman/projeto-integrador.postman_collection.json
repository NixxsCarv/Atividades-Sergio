{
  "info": {
    "name": "StudyMatch - PI - API REST",
    "description": "Requisições de teste do projeto. EXECUTAR no Postman e salvar respostas reais com Save Response antes de entregar. A ordem do fluxo assume BD vazio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUser",
      "value": "admin@studymatch.test",
      "type": "string"
    },
    {
      "key": "adminPass",
      "value": "Admin@1234",
      "type": "string"
    },
    {
      "key": "alunoUser",
      "value": "aluno@studymatch.test",
      "type": "string"
    },
    {
      "key": "alunoPass",
      "value": "Aluno@1234",
      "type": "string"
    },
    {
      "key": "disciplinaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "estudanteId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "alunoEstudanteId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "disponibilidadeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "grupoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "solicitacaoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "participacaoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "encontroId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Fluxo - Preparação e compatibilidade",
      "item": [
        {
          "name": "01 - Criar matéria Matemática",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/disciplinas",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Matemática\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Executar primeiro em banco vazio; guarde ID em disciplinaId"
          }
        },
        {
          "name": "02 - Criar estudante Ana (administradora)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/estudantes",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Ana Silva\",\"email\":\"admin@studymatch.test\",\"objetivo\":\"Vestibular\",\"disciplinaIds\":[{{disciplinaId}}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarde ID em estudanteId"
          }
        },
        {
          "name": "03 - Criar estudante Bruno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/estudantes",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Bruno Costa\",\"email\":\"aluno@studymatch.test\",\"objetivo\":\"Concurso\",\"disciplinaIds\":[{{disciplinaId}}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarde ID em alunoEstudanteId"
          }
        },
        {
          "name": "04 - Disponibilidade Ana",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/disponibilidades",
            "body": {
              "mode": "raw",
              "raw": "{\"estudanteId\":{{estudanteId}},\"diaSemana\":\"SEGUNDA\",\"horaInicio\":\"18:00\",\"horaFim\":\"21:00\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 - Disponibilidade Bruno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/disponibilidades",
            "body": {
              "mode": "raw",
              "raw": "{\"estudanteId\":{{alunoEstudanteId}},\"diaSemana\":\"SEGUNDA\",\"horaInicio\":\"18:00\",\"horaFim\":\"21:00\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "06 - Criar grupo (com vaga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/grupos",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Grupo Matemática\",\"descricao\":\"Exercícios semanais\",\"disciplinaId\":{{disciplinaId}},\"administradorId\":{{estudanteId}},\"diaSemana\":\"SEGUNDA\",\"horaInicio\":\"19:00\",\"horaFim\":\"20:00\",\"capacidade\":2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarde ID em grupoId"
          }
        },
        {
          "name": "07 - Consulta personalizada - grupos de Matemática na segunda",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/grupos?disciplinaId={{disciplinaId}}&diaSemana=SEGUNDA"
          }
        },
        {
          "name": "08 - Consulta personalizada - disponibilidade de Bruno",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/disponibilidades?estudanteId={{alunoEstudanteId}}"
          }
        },
        {
          "name": "09 - Encontrar grupos compatíveis com Bruno",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/grupos/compativeis?estudanteId={{alunoEstudanteId}}",
            "description": "Funcionalidade específica, esperado HTTP 200 com grupo correspondente"
          }
        }
      ]
    },
    {
      "name": "Fluxo - Solicitação, aprovação e encontros",
      "item": [
        {
          "name": "01 - Bruno solicita entrada (ALUNO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitacoes",
            "body": {
              "mode": "raw",
              "raw": "{\"estudanteId\":{{alunoEstudanteId}},\"grupoId\":{{grupoId}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{alunoUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{alunoPass}}",
                  "type": "string"
                }
              ]
            },
            "description": "Esperado 201 PENDENTE; anote o ID em solicitacaoId"
          }
        },
        {
          "name": "02 - Listar solicitações pendentes (consulta personalizada)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitacoes?status=PENDENTE"
          }
        },
        {
          "name": "03 - Aprovar solicitação (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitacoes/{{solicitacaoId}}/aprovar",
            "description": "Esperado 200 APROVADA; cria participação automaticamente"
          }
        },
        {
          "name": "04 - Listar membros do grupo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/participacoes?grupoId={{grupoId}}",
            "description": "Esperado 200, contendo Bruno"
          }
        },
        {
          "name": "05 - Criar encontro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/encontros",
            "body": {
              "mode": "raw",
              "raw": "{\"grupoId\":{{grupoId}},\"inicio\":\"2026-11-30T19:00:00\",\"fim\":\"2026-11-30T20:00:00\",\"localDescricao\":\"Biblioteca central\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Esperado 201, em segunda-feira dentro do horário do grupo"
          }
        },
        {
          "name": "06 - Listar calendário dos encontros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/encontros?grupoId={{grupoId}}"
          }
        },
        {
          "name": "07 - Rejeitar solicitação (use outra pendente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/solicitacoes/{{solicitacaoId}}/rejeitar",
            "description": "Caso solicitação já aprovada: esperado 409. Para demonstrar rejeição, crie outra solicitação pendente."
          }
        }
      ]
    },
